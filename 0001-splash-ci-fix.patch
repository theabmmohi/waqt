From 77e1b84368401e3aa84c998a43d7b923b57c6485 Mon Sep 17 00:00:00 2001
From: theabmmohi <theabmmohi@gmail.com>
Date: Sat, 8 Aug 2026 05:23:30 +0000
Subject: [PATCH] Strip regenerated splash images from CI build so they never
 end up in the APK [Claude]

---
 .github/workflows/build.yml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index d5ee20a..1b3545b 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -41,6 +41,11 @@ jobs:
         run: npm run build
       - name: Generate app icons
         run: npx --yes @capacitor/assets generate --android
+      - name: Remove generated splash images
+        # @capacitor/assets always regenerates a splash screen from resources/icon.png
+        # alongside the launcher icons — nothing references it anymore (see AndroidManifest.xml
+        # / styles.xml), so strip it out rather than bundling dead weight into the APK.
+        run: find android/app/src/main/res -iname "splash*.png" -delete
       - name: Sync Capacitor
         run: npx cap sync android
       - name: Decode keystore
-- 
2.43.0

